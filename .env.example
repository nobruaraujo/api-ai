# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Database
SPRING_DATASOURCE_DATABASE=api_ai_db
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/api_ai_db
SPRING_DATASOURCE_USERNAME=api_ai_user
SPRING_DATASOURCE_PASSWORD=your-strong-password-here
SPRING_DATASOURCE_ROOT_PASSWORD=your-strong-root-password-here

# Timezone
TZ=America/Sao_Paulo

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your-twilio-sid-here
TWILIO_AUTH_TOKEN=your-twilio-token-here
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
